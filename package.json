{
  "name": "trix",
  "version": "0.1.0",
  "private": true,
  "description": "AI personal trainer Telegram bot on Cloudflare Workers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanych44474/trix.git"
  },
  "homepage": "https://github.com/sanych44474/trix#readme",
  "bugs": {
    "url": "https://github.com/sanych44474/trix/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types && npm run generate:contracts",
    "types": "wrangler types",
    "build:webapp": "node --import tsx scripts/build-webapp.mjs",
    "build:webapp:v2": "vite build --config apps/mini-app/vite.config.ts",
    "build:webapp:all": "npm run build:webapp && npm run build:webapp:v2",
    "verify-v2-backfill": "node scripts/verify-v2-backfill.mjs",
    "generate:contracts": "npx -y openapi-typescript@7.13.0 packages/contracts/openapi.yaml -o packages/contracts/generated.ts",
    "dev": "npm run build:webapp:all && wrangler dev",
    "deploy": "npm run build:webapp:all && wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "typecheck:webapp": "tsc -p apps/mini-app/tsconfig.json --noEmit",
    "test": "node --import tsx --experimental-sqlite --test \"test/*.test.ts\"",
    "smoke": "node scripts/smoke.mjs",
    "verify-schema": "node scripts/verify-schema.mjs",
    "check:ai-models": "node --import tsx scripts/check-ai-models.mjs",
    "test:workers": "vitest run",
    "backup:d1": "node scripts/backup-d1.mjs"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
