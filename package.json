{
  "name": "trix",
  "version": "0.1.0",
  "private": true,
  "description": "AI personal trainer Telegram bot on Cloudflare Workers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanych44474/trix.git"
  },
  "homepage": "https://github.com/sanych44474/trix#readme",
  "bugs": {
    "url": "https://github.com/sanych44474/trix/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types",
    "types": "wrangler types",
    "build:webapp": "node --import tsx scripts/build-webapp.mjs",
    "dev": "npm run build:webapp && wrangler dev",
    "deploy": "npm run build:webapp && wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --experimental-sqlite --test \"test/*.test.ts\"",
    "smoke": "node scripts/smoke.mjs",
    "verify-schema": "node scripts/verify-schema.mjs",
    "check:ai-models": "node --import tsx scripts/check-ai-models.mjs",
    "test:workers": "vitest run",
    "backup:d1": "node scripts/backup-d1.mjs"
  },
  "dependencies": {
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.6",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
