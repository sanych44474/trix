# /app is now a tiny static redirect to /app-v2 (scripts/build-webapp.mjs) -- the legacy vanilla-JS
# shell is retired. no-cache (not a long max-age) so a client with a stale cached copy of this
# tiny page still re-fetches promptly rather than being stuck on an old version for a day.
# img-src allows cdn.jsdelivr.net for the logger's technique pictures (free-exercise-db, pinned commit).
/app
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline'
  Cache-Control: no-cache
/app.html
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline'
  Cache-Control: no-cache
/app-v2
  Content-Security-Policy: default-src 'none'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: blob: https://cdn.jsdelivr.net; media-src 'self' blob:
  Cache-Control: no-cache
# The service worker must be re-checked on every open (a new build = a new file list), and may
# control "/app-v2" itself, one level above its own folder.
/app-v2/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /app-v2
/app-v2/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: blob: https://cdn.jsdelivr.net; media-src 'self' blob:
  Cache-Control: public, max-age=86400
/mascot.png
  Cache-Control: public, max-age=604800
