# Copy to .dev.vars (gitignored) and fill in. Values here override [vars] from wrangler.toml
# during `wrangler dev`, so this is also where local deployment identity lives.

# --- Required: Telegram ---
# From @BotFather. TELEGRAM_WEBHOOK_SECRET is any random string you also pass to setWebhook.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# --- Deployment identity ---
# Your bot's @username without the @, its numeric id, and its display name. BOT_ID +
# BOT_USERNAME let the Worker skip a getMe call per webhook; leave them empty to pay for one.
BOT_USERNAME=""
BOT_ID=""
BOT_NAME=""
# Public origin of your deployed Worker, e.g. https://trix.<your-subdomain>.workers.dev.
# Leave empty in local dev to hide the Mini App buttons (there is no URL yet to link them to).
WORKER_URL=""
# Explicit opt-in for the ?debugUser= Mini App auth bypass — set to "1" for local dev only.
# Never set this in a deployed environment; see wrangler.toml's comment on the same var.
ALLOW_DEBUG_USER="1"

# --- Cloudflare ---
# Wrangler reads this instead of an account_id committed to wrangler.toml.
CLOUDFLARE_ACCOUNT_ID=""

# --- AI providers (all optional; the chain falls back through whatever is configured) ---
# Gemini leads for plan/translate, Groq for conversational kinds, then OpenRouter, then the
# on-platform Workers AI binding (needs no key at all).
GEMINI_API_KEY=""
GEMINI_FALLBACK_MODELS=""
GROQ_API_KEY=""
OLLAMA_API_KEY=""
OPENROUTER_API_KEY=""

# --- Optional data sources ---
# YouTube Data API v3 — exercise technique shorts (cache-first, ~100 search.list calls/day free).
YOUTUBE_API_KEY=""
# API Ninjas — only scripts/seed-exercises.mjs uses it, never the runtime.
EXERCISES_API_KEY=""
# USDA FoodData Central — nutrition cross-check. "DEMO_KEY" works for light use.
USDA_FDC_API_KEY=""

# --- Admin ---
# Guards the /admin/* routes. Use a long random string; anyone holding it is the operator.
ADMIN_SECRET=""

# --- Standalone app email sign-in ---
# Generate a unique 32+ character random secret; set in production with `wrangler secret put AUTH_SECRET`.
AUTH_SECRET=""
# Google OAuth Web client ID used as the server audience for Android Credential Manager tokens.
GOOGLE_CLIENT_ID=""
# Resend API key and a verified sender address for one-time sign-in codes.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="TRIX <login@example.com>"
# Firebase service-account JSON (whole file, one line) for native-app push. Production:
#   npx wrangler secret put FCM_SERVICE_ACCOUNT < C:/path/to/service-account.json
# Keep the key file outside the repository.
FCM_SERVICE_ACCOUNT=""

# --- Monitoring ---
# Healthchecks.io ping URL (https://hc-ping.com/<uuid>) -- external cron monitoring. Leave empty locally.
HEALTHCHECK_PING_URL=""
